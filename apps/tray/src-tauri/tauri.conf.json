{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exangelos",
  "version": "0.1.0",
  "identifier": "dev.exangelos.tray",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm run build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.png"
    ]
  }
}
